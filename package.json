{
    "name": "tronwallet-adapter-e2e",
    "private": true,
    "version": "1.0.0",
    "description": "Monorepo for Tron wallet adapter test suites and related packages.",
    "license": "MIT",
    "engines": {
        "node": "22.17.0",
        "pnpm": "9.6.0"
    },
    "packageManager": "pnpm@9.6.0",
    "scripts": {
        "bootstrap": "pnpm install",
        "build": "pnpm -r build",
        "test": "pnpm -r test",
        "e2e:init": "node e2e-init.mjs",
        "e2e:all": "node e2e-all.mjs"
    },
    "pnpm": {
        "overrides": {
            "playwright@<1.55.1": "=1.55.1",
            "axios@>=1.0.0 <1.15.2": "1.15.2"
        }
    }
}
