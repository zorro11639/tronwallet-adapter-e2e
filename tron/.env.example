# Shared TRON E2E environment variables — applies to all wallets under tron/
# Copy to tron/.env and fill in your values.

# Base directory for all wallet extension files and Chromium profiles.
# Each wallet's data lives under $E2E_WALLETS_DIR/{walletId}/:
#   extensions        → unpacked extension files
#   .chromium-profile → Chromium user data directory
# Tip: point this to a directory outside the repository to reuse data across branches.
E2E_WALLETS_DIR=./e2e-data
WALLET_PASSWORD=

# TRON network
TEST_CHAIN_ID=0x94a9059e
TRON_FULL_HOST=https://nile.trongrid.io
TEST_UNKNOWN_CHAIN_ID=0xdeadbeef

# Test parameters
TEST_RECEIVER_ADDRESS=
TEST_VALUE_SUN=1000

# Wallet adapter import path (optional, for local development)
# Leave empty to use the published npm package (@tronweb3/tronwallet-adapters).
# Set to a local path relative to the project root directory, e.g.:
#   WALLET_ADAPTERS_PATH=../packages/adapters/adapters/src/index.ts
WALLET_ADAPTERS_PATH=
